{
  "expo": {
    "name": "Riah — Your baby care assistant",
    "slug": "riah",
    "scheme": "riah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/duck-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/duck-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/duck-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.riphoria.riah"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85ca9e4d-7838-46c6-86d1-9712437584ac"
      }
    }
  }
}
